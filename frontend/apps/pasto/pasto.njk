
<section class="page" id="pasto">
    <div class="page-heading">
        <div>
            <span class="eyebrow">GERENCIAMENTO</span>
            <h1>Pastos</h1>
            <p>Cadastro e gerenciamento das áreas de pastagem.</p>
        </div>
        <button class="btn-primary" onclick="novoPasto()">+ Novo pasto</button>
    </div>

    <div class="panel">
        <div class="panel-header">
            <h3>Pastos cadastrados</h3>
        </div>
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Descrição</th>
                        <th>Área total</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody id="tabelaPastos"></tbody>
            </table>
        </div>
    </div>
</section>

<div class="modal-overlay" id="modalPasto">
    <div class="modal">
        <h2 id="tituloPasto">Novo pasto</h2>
        <form id="formPasto">
            <input type="hidden" id="pastoid">

            <label>Descrição</label>
            <input type="text" id="descricaoPasto" required>

            <label>Área total</label>
            <input type="number" id="areaPasto" min="0" step="0.01" required>

            <div class="modal-actions">
                <button type="button" class="btn-secondary" onclick="fecharModal('modalPasto')">Cancelar</button>
                <button type="submit" class="btn-primary">Salvar</button>
            </div>
        </form>
    </div>
</div>
